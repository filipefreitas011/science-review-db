flowchart TD
    %% Style (Vermelho  PK, Vermelho tracejado chave parcial, Azul  atributos comuns)
    %% NOTAÇÃO PETER CHEN: chaves estrangeiras (ce_*) NÃO aparecem no modelo conceitual - quem representa a ligação
    %% é o losango. As FKs foram mantidas COMENTADAS em cada entidade, indicando o relacionamento que as substitui,
    %% para servirem de guia no mapeamento para o modelo lógico.
    classDef pk stroke:#f00,stroke-width:2px,fill:#fff,color:#000;
    classDef attr stroke:#00f,stroke-width:2px,fill:#fff,color:#000;
    classDef fk stroke:#0a0,stroke-width:2px,fill:#fff,color:#000;
    classDef rel fill:#555,stroke:#fff,stroke-width:1px;
    %% Chave parcial de entidade fraca (vermelho tracejado). Entidade fraca = [[nome]] (borda dupla)
    classDef pkp stroke:#f00,stroke-width:2px,stroke-dasharray:5 3,fill:#fff,color:#000;

    %% ================= ENTIDADES =================
    Evento[tbl_evento]
    PapelParticipacao[tbl_papel_participacao]
    Trilha[tbl_trilha]
    Questao[tbl_questao]
    FormularioAvaliacao[tbl_formulario_avaliacao]
    Pessoa[tbl_pessoa]
    Instituicao[tbl_instituicao]
    Decisao[tbl_decisao]
    Revisao[tbl_revisao]
    Topico[tbl_topico]
    Submissao[tbl_submissao]
    AtribuicaoRevisao[tbl_atribuicao_revisao]
    %% REMOVIDA (seção 1): tinha os mesmos atributos de tbl_atribuicao_revisao (inclusive ce_revisor) e era ligada à Submissão por um losango chamado 'autoria'. A autoria (RF7) agora é o relacionamento Rel_Pessoa_Submissao; a atribuição de revisor continua em tbl_atribuicao_revisao.
    %% AtribuicaoVersao[tbl_atribuicao_versao]
    %% Agora entidade FRACA de Submissão (antes entidade forte com cp_id_versao).
    %% "Versão 3" só faz sentido dentro de um artigo -> identificada por (submissão + nr_versao), como a rodada.
    %% Motivo: fecha o ciclo Rodada -> Versão -> Submissão (ver comentário em Rel_Rodada_VersaoSubmissao)
    VersaoSubmissao[[tbl_versao_submissao]]
    FinalidadeAlteracao[tbl_finalidade_alteracao]
    Edicao[tbl_edicao]

    %% NOVAS ENTIDADES - FILIPE
    RespostaQuestao[tbl_resposta_questao]
    ParticipanteEdicao[tbl_participante_edicao]
    %% conflito de interesse
    ConflitoInteresse[tbl_conflito_interesse]
    %% indicaçao de interesse (bidding como ta nos requisitos) do revisor pelos artigos
    PreferenciaRevisao[tbl_preferencia_revisao]
    %% relacionamento N:M entre submissao e topico
    %% REMOVIDA (seção 1): duplicava o relacionamento N:M 'abrange' (Rel_Topico_Submissao). Em Chen, N:M sem atributos é só o losango; a tabela surge no modelo lógico.
    %% SubmissaoTopico[tbl_submissao_topico]
    %% relacionamento N:M entre pessoas e topicos
    %% REMOVIDA: duplicava o relacionamento 'expertise_em' (Rel_Topico_Pessoa) e, sem as FKs, ficaria sem
    %% identificador. Seu único atributo próprio (nivel_expertise) foi movido para o losango 'expertise_em'
    %% PessoaTopico[tbl_pessoa_topico]

    %% ===== ALTERAÇÕES SEÇÃO 1 - SUBMISSÃO =====
    %% RF30 - Uma submissão pode passar por várias rodadas de avaliação.
    %% Entidade FRACA de Submissão: uma rodada não existe sozinha e é identificada por (submissão + nr_rodada).
    %% É o ponto de encontro do que muda a cada rodada: qual versão foi avaliada e qual decisão saiu dela.
    RodadaAvaliacao[[tbl_rodada_avaliacao]]
    %% RF43 - status_submissao guarda só o estado ATUAL; cada mudança de estado vira um registro aqui.
    %% Entidade FRACA de Submissão, identificada por (submissão + dt_alteracao_status).
    %% Equivale a um atributo multivalorado composto (status + quando + por quê), que em Chen vira entidade fraca.
    HistoricoStatusSubmissao[[tbl_historico_status_submissao]]

    %% ================= RELACIONAMENTOS =================
    %% RF15 - caso uma pessoa opte por revisar uma submissao de uma trilha, ela recebe papel revisor também? 
    Rel_PapelParticipacao_Trilha{participa_como}:::rel
    Rel_Edicao_Trilha{contem}:::rel
    %% (1, 1) ou (1, N) Trilhas podem ser "reutilizadas" entre as edições?
    Rel_Edicao_Evento{possui}:::rel
    Rel_Evento_Pessoa{coordena}:::rel
    %% Instituição (0, N): pode existir no BD sem pessoa vinculada
    Rel_Instituicao_Pessoa{rel}:::rel
    %% Renomeado de rel2 para tomada_por: deixa claro que é a pessoa responsável pela decisão (ce_responsavel)
    Rel_Decisao_Pessoa{tomada_por}:::rel
    Rel_AtribuicaoRevisao_Pessoa{revisa}:::rel
    %% Pelo RF13, uma revisão pode ter (1,n) revisores, mas existe ce_revisor
    Rel_VersaoSubmissao_Pessoa{is_responsavel_por}:::rel
    %% REMOVIDO junto com tbl_atribuicao_versao
    %% Rel_AtribuicaoVersao_Pessoa{rel3}:::rel
    Rel_Revisao_AtribuicaoRevisao{deve_revisar}:::rel
    %% RF18 - deve estar no MER ou só no código?
    Rel_Submissao_AtribuicaoRevisao{atribuivel_a}:::rel
    %% deveria haver relação com expertise de pessoa com topico?
    %% REMOVIDO: substituído por Rel_Pessoa_Submissao{autoria}, que liga o autor (Pessoa) à Submissão
    %% Rel_Submissao_AtribuicaoVersao{autoria}:::rel
    Rel_VersaoSubmissao_FinalidadeAlteracao{tem_como_finalidade}:::rel
    %% Alteração de autores seria a nível de implementação
    %% Prazo para elementos tirar dúvida se poderia ser uma entidade ou atributos de entidades existentes
    %% Relacionamento IDENTIFICADOR da entidade fraca VersaoSubmissao
    Rel_VersaoSubmissao_Submissao{contem2}:::rel
    Rel_Topico_Submissao{abrange}:::rel
    Rel_Topico_Pessoa{expertise_em}:::rel
    Rel_Revisao_FormularioAvaliacao{utilizado}:::rel
    Rel_Trilha_FormularioAvaliacao{possui_um}:::rel
    Rel_Questao_FormularioAvaliacao{composto_por}:::rel
    Rel_Submissao_Trilha{pertence}:::rel
    %% NOVO: tbl_topico tinha FK ce_trilha mas nenhum losango com Trilha; sem ele, remover a FK perderia a ligação
    Rel_Topico_Trilha{organiza}:::rel
    %% Entender melhor relações entre tópicos-trilha e submissão-trilha

    %% NOVOS RELACIONAMENTOS - FILIPE
    Rel_Revisao_Resposta{gera_resposta}:::rel
    Rel_Resposta_Questao{responde_a}:::rel
    Rel_Pessoa_Participante{exerce_papel}:::rel
    Rel_Edicao_Participante{ocorreu_em}:::rel
    Rel_Papel_Participante{definido_por}:::rel
    Rel_Pessoa_Conflito{declara_conflito}:::rel
    Rel_Submissao_Conflito{possui_impedimento}:::rel
    Rel_Pessoa_Preferencia{indica_interesse}:::rel
    Rel_Submissao_Preferencia{alvo_preferencia}:::rel
    %% REMOVIDO junto com tbl_submissao_topico (duplicava 'abrange')
    %% Rel_Submissao_SubTopico{classificada_em}:::rel
    %% Rel_Topico_SubTopico{categoriza}:::rel
    %% Rel_Pessoa_PessoaTopico{tem_expertise}:::rel   -> removido com tbl_pessoa_topico
    %% Rel_Topico_PessoaTopico{dominio_em}:::rel   -> removido com tbl_pessoa_topico

    %% NOVOS RELACIONAMENTOS - SEÇÃO 1
    %% RF7 - autoria é N:M entre Pessoa e Submissão, com atributos próprios (ordem e responsável)
    Rel_Pessoa_Submissao{autoria}:::rel
    %% RF30 - relacionamento identificador da entidade fraca RodadaAvaliacao
    Rel_Submissao_Rodada{passa_por}:::rel
    %% RF30 - cada rodada avalia uma versão específica do manuscrito
    Rel_Rodada_VersaoSubmissao{avalia}:::rel
    %% RF31/RF32 - a decisão é tomada sobre uma rodada (e, por ela, sobre a submissão)
    Rel_Rodada_Decisao{resulta_em}:::rel
    %% RF43 - relacionamento identificador da entidade fraca HistoricoStatusSubmissao
    Rel_Submissao_Historico{registra_status}:::rel
    %% RF43 - quem provocou a mudança de estado
    Rel_Historico_Pessoa{alterado_por}:::rel
    %% RF43 - rastreia qual decisão provocou a mudança de estado (ex.: status 'aceita' veio da decisão X)
    Rel_Historico_Decisao{originado_por}:::rel


    %% ================= LIGAÇÕES ENTIDADE <-> RELACIONAMENTO =================
    PapelParticipacao ---|1,n| Rel_PapelParticipacao_Trilha ---|1,1| Trilha
    Edicao ---|1,n| Rel_Edicao_Trilha ---|1,1| Trilha
    Edicao ---|1,1| Rel_Edicao_Evento ---|1,n| Evento
    Evento ---|1,1| Rel_Evento_Pessoa ---|1,n| Pessoa
    %% Antes (0,n)-(0,n): permitia decisão sem responsável ou com vários. Agora cada decisão tem 1 responsável;
    %% uma pessoa pode tomar 0..n decisões
    Decisao ---|1,1| Rel_Decisao_Pessoa ---|0,n| Pessoa
    AtribuicaoRevisao ---|1,1| Rel_AtribuicaoRevisao_Pessoa ---|1,n| Pessoa
    %% Cada envio só tem 1 responsável - tem ce_responsavel_envio
    %% RESTRIÇÃO (caminho duplo Versão -> Pessoa e Versão -> Submissão -> autoria -> Pessoa):
    %%  quem envia a versão deve ser autor da MESMA submissão (estar em Rel_Pessoa_Submissao).
    %%  "Responsável pelo envio" (upload desta versão) != "autor responsável" (st_autor_responsavel)
    VersaoSubmissao ---|1,1| Rel_VersaoSubmissao_Pessoa ---|0,n| Pessoa
    %% REMOVIDO junto com tbl_atribuicao_versao
    %% AtribuicaoVersao ---|0,n| Rel_AtribuicaoVersao_Pessoa ---|0,n| Pessoa
    Revisao ---|0,n| Rel_Revisao_AtribuicaoRevisao ---|0,n| AtribuicaoRevisao
    %% Antes Submissao (1,n): obrigava toda submissão a nascer com atribuição. Ela é registrada antes de ter revisores
    Submissao ---|0,n| Rel_Submissao_AtribuicaoRevisao ---|1,1| AtribuicaoRevisao
    %% Submissao ---|0,n| Rel_Submissao_AtribuicaoVersao ---|0,n| AtribuicaoVersao
    %% Antes (1,1)-(1,1): cada finalidade só poderia ser usada por UMA versão. FinalidadeAlteracao é um catálogo
    %% (ex.: 'submissão inicial', 'correção solicitada', 'versão final'): cada versão tem 1 finalidade (RF11)
    %% e cada finalidade é usada por 0..n versões
    VersaoSubmissao ---|1,1| Rel_VersaoSubmissao_FinalidadeAlteracao ---|0,n| FinalidadeAlteracao
    %% Versão (1,1): pertence a uma submissão (identificador).
    %% Submissão (0,n): antes (1,n). A submissão pode ser registrada só com os dados do RF6 (título, resumo...)
    %% e receber o manuscrito depois, enquanto o prazo estiver aberto (RF11)
    VersaoSubmissao ---|1,1| Rel_VersaoSubmissao_Submissao ---|0,n| Submissao
    %% Tópico: antes (1,n) - obrigava todo tópico a já ter submissão; a trilha cadastra tópicos antes de abrir
    %% submissões. Submissão (1,n): deve ser classificada em pelo menos um tópico
    Topico ---|0,n| Rel_Topico_Submissao ---|1,n| Submissao
    %% RESTRIÇÃO (caminho duplo Submissão -> Trilha e Submissão -> Tópico -> Trilha):
    %%  os tópicos de uma submissão devem pertencer à MESMA trilha da submissão
    %% Antes (1,n)-(1,n): obrigava toda pessoa a declarar expertise. Adotada a cardinalidade de tbl_pessoa_topico,
    %% que é a correta: um autor não precisa declarar tópicos e um tópico pode não ter especialistas ainda
    Topico ---|0,n| Rel_Topico_Pessoa ---|0,n| Pessoa
    %% nivel_expertise veio de tbl_pessoa_topico: pertence ao par (pessoa, tópico), não a um dos dois
    Attr_NivelExpertise([nivel_expertise]):::attr
    Rel_Topico_Pessoa --- Attr_NivelExpertise

    Revisao ---|1,1| Rel_Revisao_FormularioAvaliacao ---|1,n| FormularioAvaliacao
    %% Atributos ligados ao Relacionamento N:M (Formulário e Questão)
    Attr_Quest_Form_OrdemApresentacao([quest_form_ordemApresentacao]):::attr 
    Attr_Quest_Form_Peso([quest_form_peso]):::attr                            
    Attr_Quest_Form_Obrigatoriedade([quest_form_obrigatoriedade]):::attr
    Attr_Quest_Form_Visibilidade([quest_form_visibilidade ]):::attr
    Rel_Questao_FormularioAvaliacao --- Attr_Quest_Form_OrdemApresentacao
    Rel_Questao_FormularioAvaliacao --- Attr_Quest_Form_Peso
    Rel_Questao_FormularioAvaliacao --- Attr_Quest_Form_Obrigatoriedade
    %% Resolve o RF27 (ex: 'PÚBLICO_AUTOR' ou 'RESTRITO_COORDENACAO')
    Rel_Questao_FormularioAvaliacao --- Attr_Quest_Form_Visibilidade 

    Trilha ---|1,1| Rel_Trilha_FormularioAvaliacao ---|1,n| FormularioAvaliacao
    Questao ---|1,n| Rel_Questao_FormularioAvaliacao ---|1,n| FormularioAvaliacao
    Submissao ---|1,1| Rel_Submissao_Trilha ---|0,n| Trilha
    %% Tópico (1,1): pertence a uma trilha (era a FK ce_trilha); Trilha (0,n): pode ser criada antes dos tópicos
    Topico ---|1,1| Rel_Topico_Trilha ---|0,n| Trilha
    %% NOVAS LIGAÇÕES - FILIPE
    Revisao ---|1,n| Rel_Revisao_Resposta ---|1,1| RespostaQuestao
    RespostaQuestao ---|1,1| Rel_Resposta_Questao ---|1,1| Questao
    Pessoa ---|1,n| Rel_Pessoa_Participante ---|1,1| ParticipanteEdicao
    Edicao ---|1,n| Rel_Edicao_Participante ---|1,1| ParticipanteEdicao
    PapelParticipacao ---|1,n| Rel_Papel_Participante ---|1,1| ParticipanteEdicao
    Pessoa ---|0,n| Rel_Pessoa_Conflito ---|1,1| ConflitoInteresse
    Submissao ---|0,n| Rel_Submissao_Conflito ---|1,1| ConflitoInteresse
    Pessoa ---|0,n| Rel_Pessoa_Preferencia ---|1,1| PreferenciaRevisao
    Submissao ---|0,n| Rel_Submissao_Preferencia ---|1,1| PreferenciaRevisao
    %% REMOVIDO junto com tbl_submissao_topico
    %% Submissao ---|1,n| Rel_Submissao_SubTopico ---|1,1| SubmissaoTopico
    %% Topico ---|1,n| Rel_Topico_SubTopico ---|1,1| SubmissaoTopico
    %% Pessoa ---|0,n| Rel_Pessoa_PessoaTopico ---|1,1| PessoaTopico   -> removido com tbl_pessoa_topico
    %% Topico ---|0,n| Rel_Topico_PessoaTopico ---|1,1| PessoaTopico   -> removido com tbl_pessoa_topico

    %% ===== NOVAS LIGAÇÕES - SEÇÃO 1 =====
    %% RF7 - Autoria: toda submissão tem 1..n autores; uma pessoa pode ser autora de 0..n submissões
    Submissao ---|1,n| Rel_Pessoa_Submissao ---|0,n| Pessoa
    %% Atributos do relacionamento: não pertencem à Pessoa (ela tem ordens diferentes em cada artigo)
    %% nem à Submissão (ela tem vários autores) -> pertencem ao par (pessoa, submissão)
    Attr_Autoria_NrOrdem([nr_ordem_autoria]):::attr
    Attr_Autoria_StResponsavel([st_autor_responsavel]):::attr
    Rel_Pessoa_Submissao --- Attr_Autoria_NrOrdem
    Rel_Pessoa_Submissao --- Attr_Autoria_StResponsavel
    %% Regras que a cardinalidade não expressa (restrição de integridade / aplicação):
    %%  - nr_ordem_autoria único dentro da mesma submissão (sem dois "1º autor")
    %%  - pelo menos um autor com st_autor_responsavel = verdadeiro por submissão

    %% RF30 - Submissão (0,n): pode ainda não ter entrado em avaliação; rodada (1,1): pertence a uma submissão
    Submissao ---|0,n| Rel_Submissao_Rodada ---|1,1| RodadaAvaliacao
    %% Rodada (1,1): avalia exatamente uma versão; versão (0,n): pode nunca ser avaliada (substituída no prazo)
    %% ou ser reavaliada em outra rodada
    RodadaAvaliacao ---|1,1| Rel_Rodada_VersaoSubmissao ---|0,n| VersaoSubmissao
    %% RESTRIÇÃO (caminho duplo Rodada -> Submissão e Rodada -> Versão -> Submissão):
    %%  a versão avaliada deve ser da MESMA submissão da rodada. Como Rodada e Versão são fracas de Submissão,
    %%  no modelo lógico a rodada referencia a versão por (ce_submissao, nr_versao_avaliada) usando o mesmo
    %%  ce_submissao da sua própria chave -> o banco garante a regra sem depender da aplicação.
    %% RESTRIÇÃO (RF11): a versão avaliada deve ter dt_envio <= dt_inicio_rodada (enviada antes de a rodada começar)
    %% RF31/RF32 - Rodada (0,n): em andamento não tem decisão; pode ter mais de uma se a decisão for revista
    %% Decisão (1,1): sempre referente a uma rodada. Substitui a FK solta ce_submissao, que não tinha losango
    RodadaAvaliacao ---|0,n| Rel_Rodada_Decisao ---|1,1| Decisao

    %% RF43 - Submissão (1,n): ao ser registrada já ganha o primeiro registro (status inicial)
    Submissao ---|1,n| Rel_Submissao_Historico ---|1,1| HistoricoStatusSubmissao
    %% Histórico (0,1): mudanças automáticas (ex.: fim de prazo) não têm pessoa responsável
    %% Fronteira com VersaoSubmissao: o histórico guarda mudanças de ESTADO da submissão; o envio de arquivo
    %% já fica na própria versão (dt_envio + responsável). Não criar estados como "versão 3 enviada" (duplicaria dado)
    HistoricoStatusSubmissao ---|0,1| Rel_Historico_Pessoa ---|0,n| Pessoa
    %% Histórico (0,1): nem toda mudança vem de decisão (ex.: 'registrada', 'em avaliação');
    %% Decisão (0,1): gera no máximo uma mudança de estado (pode não gerar, ex.: decisão revista para o mesmo estado)
    HistoricoStatusSubmissao ---|0,1| Rel_Historico_Decisao ---|0,1| Decisao
    %% RESTRIÇÕES (caminho duplo Histórico -> Submissão e Histórico -> Decisão -> Rodada -> Submissão):
    %%  - a decisão ligada deve ser de uma rodada da MESMA submissão do histórico
    %%  - dt_alteracao_status >= dt_decisao

    Instituicao ---|0,n| Rel_Instituicao_Pessoa ---|0,n| Pessoa
    %% Atributos ligados ao Relacionamento N:M (Pessoa e Instituição)
    %% dt_fim_vinculo vazio = vínculo ativo; tempo de vínculo é derivado das datas
    Attr_Vinculo_TpVinculo([tp_vinculo]):::attr
    Attr_Vinculo_DtInicio([dt_inicio_vinculo]):::attr
    Attr_Vinculo_DtFim([dt_fim_vinculo]):::attr
    Rel_Instituicao_Pessoa --- Attr_Vinculo_TpVinculo
    Rel_Instituicao_Pessoa --- Attr_Vinculo_DtInicio
    Rel_Instituicao_Pessoa --- Attr_Vinculo_DtFim

    %% ================= ATRIBUTOS (Elipses) =================
    %% Atributos tbl_evento
    PK_Evento([cp_id_evento]):::pk
    Attr_NmEvento([nm_evento]):::attr
    Attr_SgEvento([sg_evento]):::attr
    Attr_DsEvento([ds_evento]):::attr
    %% FK_Evento_Coordenador([ce_coordenador]):::fk   -> ligação representada por Rel_Evento_Pessoa{coordena}

    Evento --- PK_Evento
    Evento --- Attr_NmEvento
    Evento --- Attr_SgEvento
    Evento --- Attr_DsEvento
    %% Evento --- FK_Evento_Coordenador

    %% Atributos tbl_papel_participacao
    PK_PapelPessoa([cp_id_papel_pessoa]):::pk
    Attr_DsParticipacao([ds_participacao]):::attr
    Attr_NmTituloParticipacao([nm_titulo_participacao]):::attr

    PapelParticipacao --- PK_PapelPessoa
    PapelParticipacao --- Attr_DsParticipacao
    PapelParticipacao --- Attr_NmTituloParticipacao

    %% Atributos tbl_trilha
    PK_Trilha([cp_id_trilha]):::pk
    %% FK_Trilha_Edicao([ce_edicao]):::fk   -> ligação representada por Rel_Edicao_Trilha{contem}
    Attr_TpAnonimato([tp_anonimato]):::attr
    Attr_NrRevisoresDesejado([nr_revisores_desejado]):::attr
    Attr_NmTrilha([nm_trilha]):::attr
    Attr_DsTrilha([ds_trilha]):::attr
    Attr_QtdRevisoesMaxPorPessoa([qtd_revisoes_max_por_pessoa]):::attr

    Trilha --- PK_Trilha
    %% Trilha --- FK_Trilha_Edicao
    Trilha --- Attr_TpAnonimato
    Trilha --- Attr_NrRevisoresDesejado
    Trilha --- Attr_NmTrilha
    Trilha --- Attr_DsTrilha
    Trilha --- Attr_QtdRevisoesMaxPorPessoa

    %% Atributos tbl_questao
    PK_Questao([cp_id_questao]):::pk
    %% Attr_OrdemApresentacao([ordem_apresentacao]):::attr   Dar flexibilidade para questões terem esses atributos 
    %% Attr_peso([peso]):::attr                              difrentes a depender do formulário/trilha
    %% Attr_obrigatoriedade([obrigatoriedade]):::attr
    Attr_TipoResposta([tipo_resposta]):::attr
    Attr_Status([status]):::attr
    Attr_EnunciadoPergunta([enunciado_pergunta]):::attr

    Questao --- PK_Questao
    Questao --- Attr_EnunciadoPergunta
    Questao --- Attr_TipoResposta
    Questao --- Attr_Status

    %% Atributos tbl_formulario_avaliacao
    PK_Formulario([cp_id_formulario]):::pk
    %% FK_Formulario_Trilha([ce_trilha]):::fk   -> ligação representada por Rel_Trilha_FormularioAvaliacao{possui_um}
    Attr_NmFormulario([nm_formulario]):::attr
    Attr_NrVersao([nr_versao]):::attr
    Attr_DtInicioVigencia([dt_inicio_vigencia]):::attr
    Attr_DtFimVigencia([dt_fim_vigencia]):::attr
    %% Resolve o RF21
    Attr_EtapaAvaliacao([tp_etapa_avaliacao]):::attr 

    FormularioAvaliacao --- PK_Formulario
    %% FormularioAvaliacao --- FK_Formulario_Trilha
    FormularioAvaliacao --- Attr_NmFormulario
    FormularioAvaliacao --- Attr_NrVersao
    FormularioAvaliacao --- Attr_DtInicioVigencia
    FormularioAvaliacao --- Attr_DtFimVigencia
    FormularioAvaliacao --- Attr_EtapaAvaliacao

    %% Atributos tbl_pessoa
    PK_Pessoa([cp_id_pessoa]):::pk
    Attr_NmPessoa([nm_pessoa]):::attr
    Attr_EmailPrincipal([email_principal]):::attr
    Attr_CdOrcid([cd_orcid]):::attr
    Attr_PaisPessoa([pais_pessoa]):::attr

    Pessoa --- PK_Pessoa
    Pessoa --- Attr_NmPessoa
    Pessoa --- Attr_EmailPrincipal
    Pessoa --- Attr_CdOrcid
    Pessoa --- Attr_PaisPessoa

    %% Atributos tbl_instituicao
